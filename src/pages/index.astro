  <script is:inline>
    (function () {
      var form = document.getElementById('contactForm');
      var success = document.getElementById('formSuccess');
      var btn = document.getElementById('submitBtn');
      var next = document.getElementById('formNext');
      if (next) next.value = window.location.href.split('?')[0] + '?submitted=true#contact';
      if (window.location.search.indexOf('submitted=true') !== -1 && form && success) {
        form.style.display = 'none';
        success.classList.add('show');
        history.replaceState({}, '', window.location.pathname + '#contact');
      }
      if (form && btn) form.addEventListener('submit', function () { btn.textContent = 'Sending...'; btn.disabled = true; });
    })();
  </script>
